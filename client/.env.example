# Base URL of the DePhish Express backend.
# In production (Vercel), set this to your Render service URL.
# In local development, leave blank — the Vite dev proxy handles routing.
VITE_API_URL=

# Local development proxy targets (dev server only — no effect on production build).
ML_API_PROXY_TARGET=http://127.0.0.1:8000
AUTH_API_PROXY_TARGET=http://127.0.0.1:5000
