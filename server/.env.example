# Backend configuration: save private values only in server/.env.
# Keep sensitive values blank in .env.example and in source code.
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# SENSITIVE: paste your Atlas connection string after the equals sign below.
# It contains the DATABASE user's username/password, cluster address, and database name.
# This is NOT a DePhish user's login. App users register through the signup form.
# Location in Atlas: your cluster > Connect > Drivers > connection string.
MONGODB_URI=

# Optional database override; otherwise use the database in MONGODB_URI.
DB_NAME=
# Collection for signed-in scan history (default scan_reports; not user accounts).
COLLECTION_NAME=

# SENSITIVE: place your private random session-signing secret here (32+ characters).
# Keep this value stable across restarts. Do not share it or commit it to Git.
SESSION_SECRET=

# Outbound SMTP for password reset codes and password-change notices.
# Examples: your provider's SMTP host, port 587 with STARTTLS, and an app password/API credential.
# Quote values containing # or other dotenv-special characters.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=2525
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL= 
BREVO_SENDER_NAME=DePhish

# Non-secret browser origins allowed to make account requests.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only behind one trusted reverse proxy.
TRUST_PROXY=0
